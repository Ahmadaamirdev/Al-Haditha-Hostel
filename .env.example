# Server Environment Configuration Template
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Atlas or Local replica set for transactions)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/alhaditha_hostel?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=8h

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Notification Thresholds (in days)
UPCOMING_CHECKOUT_DAYS_THRESHOLD=2

